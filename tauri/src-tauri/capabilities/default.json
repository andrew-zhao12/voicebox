{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default permissions for voicebox",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main", "dictate"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:webview:allow-internal-toggle-devtools",
    "shell:allow-open",
    "updater:default",
    "process:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "allow-start-server",
    "allow-stop-server",
    "allow-restart-server",
    "allow-set-keep-server-running",
    "allow-set-backend-override",
    "allow-get-server-credentials",
    "allow-start-system-audio-capture",
    "allow-stop-system-audio-capture",
    "allow-is-system-audio-supported",
    "allow-list-audio-output-devices",
    "allow-play-audio-to-devices",
    "allow-stop-audio-playback",
    "allow-debug-clipboard-roundtrip",
    "allow-debug-paste-text",
    "allow-debug-capture-focus",
    "allow-debug-focus-roundtrip",
    "allow-check-accessibility-permission",
    "allow-check-input-monitoring-permission",
    "allow-open-accessibility-settings",
    "allow-open-input-monitoring-settings",
    "allow-paste-final-text",
    "allow-enable-hotkey",
    "allow-disable-hotkey",
    "allow-update-chord-bindings"
  ]
}
