# Plain-HTTP load balancer for docker-compose.fleet.yml (local verification).
# Cloud deployments use the platform's load balancer instead; see deploy/.
:80 {
	encode zstd gzip

	reverse_proxy voicebox-a:17493 voicebox-b:17493 {
		# Route to the replica with the fewest open requests (streams are long),
		# skip replicas whose readiness probe fails, and retry a refused
		# connection on the other replica before the client sees an error.
		lb_policy least_conn
		lb_try_duration 5s
		health_uri /health/ready
		health_interval 2s
		# A replica busy with synthesis can take a moment to answer the probe.
		health_timeout 5s
		# A 503 means the replica is draining (a full queue answers 429), so stop
		# routing to it at once instead of waiting for the next health check.
		unhealthy_status 503
		fail_duration 30s
		# Unbuffered SSE and audio streams.
		flush_interval -1
	}
}
